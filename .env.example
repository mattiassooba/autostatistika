# Local warehouse
INGESTION_DB=./data/autostatistika.db
DATA_DIR=./data
PUBLISH_DIR=./apps/web/data/published

# Optional hosted warehouse. The public website works from published JSON without these.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=source-files

# Optional insight phrasing. Deterministic sentences are always generated.
OPENAI_API_KEY=
INSIGHT_MODEL=gpt-4.1-mini

# Optional AI wording of the brand trend analysis: URL of the trend-analyst Worker
# (workers/trend-analyst), read at build time. Unset: computed text only.
# The Anthropic key lives only in the Worker (`wrangler secret put ANTHROPIC_API_KEY`).
NEXT_PUBLIC_TREND_API_URL=

# Optional failure webhook
ALERT_WEBHOOK_URL=

# Optional monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
